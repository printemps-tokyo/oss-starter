{
  "name": "@printemps-tokyo/oss-starter",
  "version": "0.1.0",
  "description": "TypeScript CLI starter template for printemps-tokyo open source projects.",
  "type": "module",
  "license": "MIT",
  "author": "Yosuke Sakata (printemps.tokyo)",
  "homepage": "https://github.com/printemps-tokyo/oss-starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/printemps-tokyo/oss-starter.git"
  },
  "bugs": {
    "url": "https://github.com/printemps-tokyo/oss-starter/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "oss-starter": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
